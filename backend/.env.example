# Comma-separated browser origins allowed to call the backend.
LOCALHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenCV camera device index. The current server setup uses device 1.
LOCALHUB_CAMERA_INDEX=1

# Maximum uploaded file size, in bytes (default: 104857600 / 100 MiB).
LOCALHUB_MAX_UPLOAD_BYTES=104857600
